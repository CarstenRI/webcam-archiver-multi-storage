# Webcam-Uploader – Konfiguration
# Diese Datei wird vom install.sh nach /etc/webcam-uploader/.env kopiert
# und kann dort weiter angepasst werden. Service-Restart danach:
#   sudo systemctl restart webcam-uploader

# --- Web-UI ---
WU_HOST=0.0.0.0
WU_PORT=8080
WU_BASE_URL=http://localhost:8080

# Basic-Auth Login (Pflichtfelder!)
WU_AUTH_USER=admin
WU_AUTH_PASSWORD=change-me-please

# --- Datenbank & Storage ---
WU_DATA_DIR=/var/lib/webcam-uploader
WU_TMP_DIR=/var/lib/webcam-uploader/tmp
WU_LOG_LEVEL=INFO

# --- Amazon Photos Session ---
# Diese Werte werden bequem über die Web-UI (Settings) eingetragen –
# du musst hier nichts vorbelegen. Sie werden in der DB gespeichert.

# --- Duplicate-Detection ---
# Hamming-Distanz-Schwellwert für perceptual hash. <=5 = praktisch identisch.
WU_DUPLICATE_HASH_THRESHOLD=5

# --- Scheduler ---
# Sicherheits-Begrenzung: Maximale parallele Fetches.
WU_MAX_CONCURRENT_FETCHES=5
